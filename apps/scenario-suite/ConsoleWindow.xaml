<Window x:Class="ScenarioSuite.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenario Suite - console" Height="680" Width="940"
        AutomationProperties.AutomationId="console_window">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="联系人" FontWeight="SemiBold" />
    <!-- Contact rows: each is a titled row with an action, which is the shape
         the packless entity heuristic recognises as a selectable/actionable
         row ("title + verb button" / ">=3 same-shaped titled siblings"). -->
    <ListBox Grid.Row="1" Grid.Column="0" x:Name="Contacts"
             AutomationProperties.Name="联系人"
             AutomationProperties.AutomationId="console_contacts"
             SelectionChanged="OnContactSelected" />

    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ChatTitle" FontWeight="SemiBold"
               Text="请选择一个联系人"
               AutomationProperties.AutomationId="console_title" />
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Thread"
                    AutomationProperties.Name="消息"
                    AutomationProperties.AutomationId="console_thread">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4"
                       AutomationProperties.AutomationId="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- A plain composer: this one DOES publish a Value pattern, so it is the
         contrast case proving the native write route is preferred over the
         synthetic channels. -->
    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="Input"
             AutomationProperties.Name="输入"
             AutomationProperties.AutomationId="console_input"
             KeyDown="OnInputKeyDown" />
    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
      <Button Content="发送"
              AutomationProperties.Name="发送"
              AutomationProperties.AutomationId="console_send"
              Click="OnSendClick" />
      <TextBlock x:Name="Status" MinWidth="260" Text="就绪"
                 AutomationProperties.AutomationId="console_status" />
    </StackPanel>
  </Grid>
</Window>
