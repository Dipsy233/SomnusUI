<Window x:Class="ScenarioSuite.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScenarioSuite"
        Title="Scenario Suite - chat" Height="720" Width="980"
        AutomationProperties.AutomationId="chat_window">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left: the conversation list, a scrollable list of selectable rows. -->
    <TextBlock Grid.Row="0" Grid.Column="0" Text="会话" FontWeight="SemiBold" />
    <ListBox Grid.Row="1" Grid.Column="0" x:Name="Conversations"
             AutomationProperties.Name="会话"
             AutomationProperties.AutomationId="chat_conversations"
             SelectionChanged="OnConversationSelected" />

    <!-- Right: the message history of the selected conversation. -->
    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ConversationTitle"
               FontWeight="SemiBold" Text="请选择一个会话"
               AutomationProperties.AutomationId="chat_title" />
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Messages"
                    AutomationProperties.Name="消息"
                    AutomationProperties.AutomationId="chat_messages">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="6" Margin="2" Background="#F4F4F4" CornerRadius="4">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="{Binding AutomationId}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- The composer is genuinely SELF-DRAWN (see SelfDrawnEditor.cs): it is
         painted by hand, keeps its text in a field, and publishes nothing
         writable - no ValuePattern, no element HWND, reported by UIA as a Group
         with a self-drawn class name ("ProseMirror ExEditor"). That is the
         shape the capability report measured on QQ and 豆包's ProseMirror box,
         and the one the set_text fallback chain exists for: the only remaining
         routes are the two synthetic channels, both of which need the
         foreground and both of which are gated behind the allow-clipboard /
         allow-keyboard switches. A WPF RichTextBox would be easier but would test the
         wrong thing: it is a platform document control that merely lacks a
         writable Value pattern, not a painted surface the platform knows
         nothing about. -->
    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#BBB" BorderThickness="1" Margin="4">
        <local:SelfDrawnEditor x:Name="Composer" Height="90"
                               AutomationProperties.Name="消息编辑器"
                               AutomationProperties.AutomationId="chat_composer" />
      </Border>
      <Button Grid.Column="1" Content="发送" Width="90"
              AutomationProperties.Name="发送"
              AutomationProperties.AutomationId="chat_send"
              Click="OnSendClick" />
    </Grid>

    <!-- The send log: the verification surface. Every send appends a line here,
         so "did the message go out" is answerable from the observation. -->
    <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Header="发送记录"
              AutomationProperties.Name="发送记录"
              AutomationProperties.AutomationId="chat_outbox">
      <ListBox x:Name="Outbox" Height="80"
               AutomationProperties.Name="发送记录"
               AutomationProperties.AutomationId="chat_outbox_list" />
    </GroupBox>
  </Grid>
</Window>
