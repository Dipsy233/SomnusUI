<Window x:Class="ScenarioSuite.FormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenario Suite - form" Height="620" Width="620"
        AutomationProperties.AutomationId="form_window">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="130" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名:" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox"
             AutomationProperties.Name="姓名"
             AutomationProperties.AutomationId="form_name" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="邮箱:" />
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="EmailBox"
             AutomationProperties.Name="邮箱"
             AutomationProperties.AutomationId="form_email" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="备注:" />
    <TextBox Grid.Row="2" Grid.Column="1" x:Name="NotesBox" Height="80"
             AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             AutomationProperties.Name="备注"
             AutomationProperties.AutomationId="form_notes" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="只读编号:" />
    <TextBox Grid.Row="3" Grid.Column="1" x:Name="IdBox"
             IsReadOnly="True" Text="REQ-0001"
             AutomationProperties.Name="只读编号"
             AutomationProperties.AutomationId="form_id" />

    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
      <CheckBox x:Name="AgreeBox" Content="同意条款"
                AutomationProperties.Name="同意条款"
                AutomationProperties.AutomationId="form_agree" />
      <ComboBox x:Name="PriorityBox" Width="140" SelectedIndex="0"
                AutomationProperties.Name="优先级"
                AutomationProperties.AutomationId="form_priority">
        <ComboBoxItem Content="低" />
        <ComboBoxItem Content="中" />
        <ComboBoxItem Content="高" />
      </ComboBox>
    </StackPanel>

    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
      <Button Content="提交" IsDefault="True"
              AutomationProperties.Name="提交"
              AutomationProperties.AutomationId="form_submit"
              Click="OnSubmitClick" />
      <Button Content="重置"
              AutomationProperties.Name="重置"
              AutomationProperties.AutomationId="form_reset"
              Click="OnResetClick" />
      <Button Content="禁用按钮" IsEnabled="False"
              AutomationProperties.Name="禁用按钮"
              AutomationProperties.AutomationId="form_disabled" />
    </StackPanel>

    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ValidationText"
               Foreground="#B00" FontWeight="SemiBold" Text="未提交"
               AutomationProperties.AutomationId="form_validation" />

    <GroupBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Header="提交记录"
              AutomationProperties.Name="提交记录"
              AutomationProperties.AutomationId="form_records">
      <ListBox x:Name="Records"
               AutomationProperties.Name="提交记录"
               AutomationProperties.AutomationId="form_records_list" />
    </GroupBox>
  </Grid>
</Window>
