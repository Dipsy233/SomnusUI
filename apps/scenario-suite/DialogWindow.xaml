<Window x:Class="ScenarioSuite.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenario Suite - dialog" Height="420" Width="520"
        AutomationProperties.AutomationId="dialog_window">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListBox Grid.Row="0" x:Name="Rows"
             AutomationProperties.Name="报告"
             AutomationProperties.AutomationId="dialog_rows" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
      <!-- The destructive action. It does not delete directly: it opens a modal
           confirmation, which is the shape most real destructive actions take. -->
      <Button Content="删除" Click="OnDeleteClick"
              AutomationProperties.Name="删除"
              AutomationProperties.AutomationId="dialog_delete" />
    </StackPanel>

    <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,12,0,0" FontWeight="SemiBold"
               Text="就绪"
               AutomationProperties.AutomationId="dialog_status" />
  </Grid>
</Window>
