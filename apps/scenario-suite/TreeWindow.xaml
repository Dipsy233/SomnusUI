<Window x:Class="ScenarioSuite.TreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenario Suite - tree" Height="640" Width="720"
        AutomationProperties.AutomationId="tree_window">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <Button Content="全部展开"
              AutomationProperties.Name="全部展开"
              AutomationProperties.AutomationId="tree_expand_all"
              Click="OnExpandAll" />
      <Button Content="全部折叠"
              AutomationProperties.Name="全部折叠"
              AutomationProperties.AutomationId="tree_collapse_all"
              Click="OnCollapseAll" />
      <TextBlock x:Name="TreeStatus" MinWidth="220"
                 AutomationProperties.Name="树状态"
                 AutomationProperties.AutomationId="tree_status" />
    </StackPanel>

    <!-- A nested, expandable tree: each level multiplies the node count, so the
         same screen is either a handful of lines (collapsed) or thousands
         (expanded). That is the compression-by-expansion-level case. -->
    <TreeView Grid.Row="1" x:Name="Tree"
              AutomationProperties.Name="目录树"
              AutomationProperties.AutomationId="tree_root">
      <TreeView.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}"
                     AutomationProperties.AutomationId="{Binding AutomationId}" />
        </DataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <TextBlock Grid.Row="2" x:Name="SelectionInfo"
               AutomationProperties.Name="选中项"
               AutomationProperties.AutomationId="tree_selection" />
  </Grid>
</Window>
