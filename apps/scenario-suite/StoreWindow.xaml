<Window x:Class="ScenarioSuite.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenario Suite - store" Height="720" Width="1000"
        AutomationProperties.AutomationId="store_window">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search: a plain text box with a Value pattern, so it is written with
         the native SetValue route and needs no focus. -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="搜索:" />
      <TextBox Grid.Column="1" x:Name="SearchBox"
               AutomationProperties.Name="搜索"
               AutomationProperties.AutomationId="store_search"
               AutomationProperties.HelpText="输入关键词后按搜索或回车" />
      <Button Grid.Column="2" Content="搜索"
              AutomationProperties.Name="搜索"
              AutomationProperties.AutomationId="store_search_button"
              Click="OnSearchClick" />
      <!-- No AutomationProperties.Name on a live-value TextBlock: WPF uses
           that as the UIA Name and would report the static label instead of
           the text, hiding the very value a caller needs to read (and
           diff) - the summary would read "结果" forever. Leaving it off
           makes the text itself the Name, which is the diffable state. -->
      <TextBlock Grid.Column="3" x:Name="ResultSummary"
                 AutomationProperties.AutomationId="store_result_summary" />
    </Grid>

    <!-- The catalog: a virtualized list with a large dataset. Only a window
         of rows is realized, which is exactly the "large data + scrollable"
         case the runtime has to survive. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ProductList"
                    AutomationProperties.Name="商品"
                    AutomationProperties.AutomationId="store_products">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4" Margin="0,2">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15"
                           AutomationProperties.AutomationId="{Binding TitleAutomationId}" />
                <TextBlock Grid.Column="1" Text="{Binding PriceText}" Margin="12,0"
                           AutomationProperties.AutomationId="{Binding PriceAutomationId}" />
                <TextBlock Grid.Column="2" Text="{Binding StockText}" Margin="12,0"
                           AutomationProperties.AutomationId="{Binding StockAutomationId}" />
                <Button Grid.Column="3" Content="加入" Width="72"
                        AutomationProperties.Name="加入"
                        AutomationProperties.AutomationId="{Binding AddAutomationId}"
                        Click="OnAddClick" Tag="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Cart + the record of what was added, so a test can verify the action
         from the observation alone (no separate assertion channel needed). -->
    <GroupBox Grid.Row="2" Header="购物车" Margin="0,8,0,0"
              AutomationProperties.Name="购物车"
              AutomationProperties.AutomationId="store_cart">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="CartSummary" FontSize="15"
                   AutomationProperties.AutomationId="store_cart_count" />
        <ListBox Grid.Column="1" x:Name="CartItems" Height="80"
                 AutomationProperties.Name="购物车明细"
                 AutomationProperties.AutomationId="store_cart_items" />
        <Button Grid.Column="2" Content="结算"
                AutomationProperties.Name="结算"
                AutomationProperties.AutomationId="store_checkout"
                Click="OnCheckoutClick" />
        <TextBlock Grid.Column="3" x:Name="LastAction" MinWidth="180" Text="就绪"
                   AutomationProperties.AutomationId="store_last_action" />
      </Grid>
    </GroupBox>
  </Grid>
</Window>
