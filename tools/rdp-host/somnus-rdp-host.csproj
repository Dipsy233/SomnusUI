<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A minimal OLE host for the RDP client control, and (in probe mode) the
    bridge that asks Windows for cross-session UI Automation.

    SomnusUI is Python, and Python can create the RDP control and set
    ConnectToChildSession (verified: comtypes loads the mstscax typelib and the
    property round-trips). What Python cannot do is *embed* the control: the
    control's HWND only appears once an OLE container has activated it in place,
    and QueryInterface(IOleWindow) answers E_UNEXPECTED until then. The one
    supported container is AxHost, which lives in WinForms.

    The WinRT UIAutomation projection needs a Windows-versioned target framework;
    net8.0-windows (unversioned) cannot see Microsoft.Windows.SDK.NET, which is
    where RemoteAutomationClientSession comes from.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>somnus-rdp-host</AssemblyName>
    <RootNamespace>Somnus.RdpHost</RootNamespace>
    <!-- The control is reached by COM interop only; no COM reference is needed
         because it is embedded by CLSID, not by typelib. -->
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

</Project>
