<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SendGate.MainWindow"
        Title="Send Gate" Height="240" Width="420">
  <StackPanel Margin="12">
    <TextBox x:Name="Composer" Height="80"
             AutomationProperties.Name="composer"
             AutomationProperties.AutomationId="composer"
             TextChanged="OnComposerChanged" />
    <Button x:Name="Send" Content="发送" Height="32" Margin="0,8,0,0"
            AutomationProperties.Name="发送"
            AutomationProperties.AutomationId="send"
            IsEnabled="False" />
  </StackPanel>
</Window>
